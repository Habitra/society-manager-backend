// =============================================================================
// Society Management SaaS - Phase 1 Database Schema
// =============================================================================
// Database    : PostgreSQL 15+
// ORM         : Prisma 5.x
// Auth        : Supabase Auth (auth.users → public.users)
// Tenancy     : Shared Database, Shared Schema (community_id on all tables)
// Primary Keys: UUID (gen_random_uuid())
// Soft Delete : deleted_at nullable timestamp
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "views"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuidOssp(map: "uuid-ossp"), pgcrypto]
}

// =============================================================================
// ENUMS
// =============================================================================

/// Community verification lifecycle
enum CommunityStatus {
  PENDING // Awaiting admin verification after signup
  ACTIVE // Fully operational
  SUSPENDED // Billing failure or policy violation
  ARCHIVED // Permanently deactivated, data retained for compliance
}

/// Community type determines feature availability and billing tiers
enum CommunityType {
  APARTMENT_COMPLEX // Multi-unit high-rise
  GATED_COLONY // Independent bungalows / plots within a gate
  VILLA_COMPLEX // Villas with shared amenities
  COMMERCIAL // Office parks / commercial complexes
}

/// System-level roles – drives authorization, not profile type
/// Fine-grained permissions are handled via RBAC in the application layer
enum UserRole {
  SUPER_ADMIN // Platform-level SaaS admin (not community scoped)
  COMMUNITY_ADMIN // Society president / secretary
  MANAGER // Property manager, RWA staff
  GUARD // Security personnel at gate
  STAFF // Maintenance / housekeeping / other employees
  RESIDENT // Flat owner or tenant
  FAMILY_MEMBER // Dependent on a resident account
}

/// Controls the authentication status of a user account
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

/// Verification stage for residents
enum VerificationStage {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

/// Document verification status
enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Whether a unit is owner-occupied or tenant-occupied (impacts billing)
enum UnitOccupancyType {
  OWNER
  TENANT
  VACANT
}

/// Occupancy type for a resident in a unit
enum OccupancyType {
  OWNER_RESIDENT
  OWNER_NON_RESIDENT
  TENANT
}

/// Flat / plot / villa type
enum UnitType {
  APARTMENT
  VILLA
  PLOT
  SHOP
  OFFICE
  PENTHOUSE
}

/// Drives gate pass validation logic
enum VisitorType {
  GUEST
  DELIVERY
  COURIER
  MAID
  DRIVER
  TECHNICIAN
  VENDOR
}

/// Visitor pre-approval vs on-arrival flows
enum VisitorEntryMode {
  PRE_APPROVED
  ON_ARRIVAL
}

/// Visitor Request Lifecycle Statuses
enum VisitorRequestStatus {
  PENDING
  VIEWED
  APPROVED
  REJECTED
  EXPIRED
  ENTERED
  EXITED
}

/// Full lifecycle of a visitor gate pass
enum GatePassStatus {
  PENDING // Created by resident, awaiting guard action
  APPROVED // Guard verified and allowed entry
  DENIED // Guard refused entry
  EXPIRED // TTL exceeded without use
  CANCELLED // Resident cancelled before use
  USED // Single-use pass consumed
}

/// Maintenance ticket priority
enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Maintenance ticket resolution lifecycle
enum TicketStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD // Pending parts / resident availability
  RESOLVED
  CLOSED
  REOPENED
}

/// Invoice billing frequency
enum InvoiceCycleFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  ONE_TIME
}

/// Invoice lifecycle
enum InvoiceStatus {
  DRAFT
  PENDING
  PUBLISHED // Sent to resident
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  DISPUTED
  WAIVED
}

/// Payment gateway channels
enum PaymentMode {
  UPI
  NETBANKING
  CARD
  NEFT_RTGS
  CHEQUE
  CASH
  WALLET
}

/// Payment transaction lifecycle
enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Target audience for announcements
enum TargetAudience {
  ALL_RESIDENTS
  OWNER_RESIDENTS
  TENANTS
  NON_RESIDENT_OWNERS
  STAFF
  GUARDS
  COMMUNITY_ADMIN
  MANAGER
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Notification delivery channel
enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
  WHATSAPP
}

/// Vehicle category
enum VehicleType {
  TWO_WHEELER
  THREE_WHEELER
  FOUR_WHEELER
  HEAVY_VEHICLE
}

/// Staff / employee service category
enum StaffCategory {
  SECURITY_GUARD
  HOUSEKEEPING
  PLUMBER
  ELECTRICIAN
  CARPENTER
  LIFT_TECHNICIAN
  GARDENER
  ACCOUNTS
  MANAGER
  TECHNICIAN
  OTHER
}

/// Audit action kinds for the audit_logs table
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  SOFT_DELETE
  RESTORE
  LOGIN
  LOGOUT
  EXPORT
  PERMISSION_CHANGE
}

/// Bulk Import Type
enum ImportType {
  RESIDENT
  UNIT
  TOWER
  STAFF
  VEHICLE
}

/// Bulk Import Lifecycle Status
enum ImportStatus {
  PENDING
  VALIDATING
  PROCESSING
  COMPLETED
  FAILED
}

/// Amenity Reservation Status
enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WatchlistLevel {
  NORMAL
  WATCHLIST
  RESTRICTED
  BLACKLISTED
}

enum WatchlistEntityType {
  VISITOR_NAME
  VISITOR_PHONE
  VEHICLE_NUMBER
  VENDOR_NAME
}

enum VendorCategory {
  SECURITY
  HOUSEKEEPING
  GARDENING
  ELECTRICAL
  PLUMBING
  LIFT_MAINTENANCE
  PEST_CONTROL
  WATER_TREATMENT
  FIRE_SAFETY
  INTERNET_PROVIDER
  WASTE_MANAGEMENT
}

enum VendorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLACKLISTED
}

enum ContractStatus {
  ACTIVE
  PENDING_REVIEW
  UNDER_NEGOTIATION
  APPROVED
  RENEWED
  EXPIRED
  TERMINATED
}

enum ContractRenewalStatus {
  PENDING_REVIEW
  UNDER_NEGOTIATION
  APPROVED
  RENEWED
  TERMINATED
}

enum WorkOrderStatus {
  CREATED
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CLOSED
}

enum ComplianceStatus {
  VALID
  EXPIRING_SOON
  EXPIRED
  MISSING
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// =============================================================================
// DOMAIN: COMMUNITY (Tenant Root)
// =============================================================================

/// Root entity for every tenant.
/// All other tables belong to a community via community_id.
/// Deleting a community is prevented at DB level; use status = ARCHIVED instead.
model Community {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String          @db.VarChar(200)
  slug         String          @unique @db.VarChar(100) // URL-safe short name e.g. "greenpark-phase2"
  code         String          @unique @db.VarChar(10) // Permanent 3-letter code, e.g. "JPA"
  type         CommunityType
  status       CommunityStatus @default(PENDING)
  logoUrl      String?         @db.Text
  address      Json // { line1, line2, city, state, pincode, country }
  geoLocation  Json? // { lat, lng }
  contactEmail String          @db.VarChar(254)
  contactPhone String          @db.VarChar(20)
  timezone     String          @default("Asia/Kolkata") @db.VarChar(50)
  currency     String          @default("INR") @db.Char(3)
  totalUnits   Int             @default(0)
  settings     Json            @default("{}") // Feature flags, config per tenant
  metadata     Json            @default("{}") // Free-form extensible field

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  // Relations
  towers                  Tower[]
  units                   Unit[]
  users                   User[]
  maintenanceCategories   MaintenanceCategory[]
  invoiceCycles           InvoiceCycle[]
  announcements           Announcement[]
  auditLogs               AuditLog[]
  vehicles                Vehicle[]
  staffProfiles           StaffProfile[]
  residentUnitAssignments ResidentUnitAssignment[]
  visitorRequests         VisitorRequest[]
  residentDocuments       ResidentDocument[]
  maintenanceTickets      MaintenanceTicket[]
  invoices                Invoice[]
  passwordResetOtps       PasswordResetOtp[]
  usernameSequences       UsernameSequence[]
  importJobs              ImportJob[]
  amenities               Amenity[]
  amenityReservations     AmenityReservation[]
  watchlists              SecurityWatchlist[]
  vendors                 Vendor[]
  vendorContracts         Contract[]
  contractRenewals        ContractRenewalHistory[]
  workOrders              WorkOrder[]
  complianceRecords       ComplianceRecord[]
  vendorPayments          VendorPayment[]
  VendorFeedback          VendorFeedback[]
  VendorPerformanceMetric VendorPerformanceMetric[]
  gateAssignments         GateAssignment[]
  guardShifts             GuardShift[]
  guardAttendance         GuardAttendance[]
  guardIncidents          GuardIncident[]

  @@index([status])
  @@index([slug])
  @@index([deletedAt])
  @@map("communities")
}

// =============================================================================
// DOMAIN: SYSTEM (Platform Sequences)
// =============================================================================

/// Tracks next values for generated sequences (like usernames) safely.
model UsernameSequence {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String @db.Uuid
  userType    String @db.VarChar(50) // e.g. "COMMUNITY_ADMIN", "RESIDENT"
  nextValue   Int    @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)

  @@unique([communityId, userType])
  @@index([communityId])
  @@map("username_sequences")
}

// =============================================================================
// DOMAIN: PROPERTY (Tower / Unit)
// =============================================================================

/// Optional grouping of units into towers/blocks.
/// Non-tower societies (gated colonies) won't have tower records.
model Tower {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String @db.Uuid
  name        String @db.VarChar(100) // "Tower A", "Block 1", "Phase 2"
  code        String @db.VarChar(20) // short code e.g. "A", "B1"
  totalFloors Int    @default(0)
  totalUnits  Int    @default(0)
  amenities   Json   @default("[]") // list of amenity names for this tower
  metadata    Json   @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  units     Unit[]

  // Within a community, tower codes must be unique
  @@unique([communityId, code])
  @@index([communityId])
  @@index([communityId, deletedAt])
  @@map("towers")
}

/// Smallest billable and addressable unit (flat / villa / shop / plot).
/// Unit numbers are unique within their tower; or within the community if towerless.
/// The dual unique index is enforced via partial indexes in the migration SQL.
model Unit {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId  String            @db.Uuid
  towerId      String?           @db.Uuid
  unitNumber   String            @db.VarChar(20) // "101", "G-04", "PH-01"
  floor        Int?
  type         UnitType          @default(APARTMENT)
  occupancy    UnitOccupancyType @default(VACANT)
  areaSqFt     Decimal?          @db.Decimal(8, 2)
  bedrooms     Int?
  bathrooms    Int?
  isCommercial Boolean           @default(false)
  metadata     Json              @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  community           Community                @relation(fields: [communityId], references: [id], onDelete: Restrict)
  tower               Tower?                   @relation(fields: [towerId], references: [id], onDelete: SetNull)
  residentAssignments ResidentUnitAssignment[]
  visitorRequests     VisitorRequest[]
  maintenanceTickets  MaintenanceTicket[]
  invoices            Invoice[]
  vehicles            Vehicle[]

  // NOTE: Partial unique indexes are defined in migration.sql:
  //   idx_units_unique_with_tower    UNIQUE (tower_id, unit_number) WHERE tower_id IS NOT NULL AND deleted_at IS NULL
  //   idx_units_unique_without_tower UNIQUE (community_id, unit_number) WHERE tower_id IS NULL AND deleted_at IS NULL
  @@index([communityId])
  @@index([towerId])
  @@index([communityId, occupancy])
  @@index([communityId, deletedAt])
  @@map("units")
}

// =============================================================================
// DOMAIN: USERS (Identity + Profiles)
// =============================================================================

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId         String     @db.Uuid
  role                UserRole
  status              UserStatus @default(PENDING_VERIFICATION)
  username            String     @unique @db.VarChar(100)
  email               String     @db.VarChar(254)
  phone               String     @db.VarChar(20)
  passwordHash        String     @db.Text
  refreshTokenHash    String?    @db.Text
  firstLoginCompleted Boolean    @default(false)
  mustChangePassword  Boolean    @default(true)
  passwordChangedAt   DateTime?  @db.Timestamptz
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?  @db.Timestamptz
  displayName         String     @db.VarChar(200)
  avatarUrl           String?    @db.Text
  fcmToken            String?    @db.Text // Firebase Cloud Messaging token for push
  lastLoginAt         DateTime?  @db.Timestamptz
  metadata            Json       @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)

  // Profile relations (one-to-one; only one will be non-null based on role)
  residentProfile ResidentProfile?
  adminProfile    AdminProfile?
  staffProfile    StaffProfile?

  guardShifts      GuardShift[]      @relation("GuardShifts")
  supervisorShifts GuardShift[]      @relation("SupervisorShifts")
  guardAttendance  GuardAttendance[]
  guardIncidents   GuardIncident[]

  // Activity relations
  residentAssignments  ResidentUnitAssignment[]
  visitorRequestsMade  VisitorRequest[]         @relation("VisitorRequestedBy")
  gatePassesApproved   GatePass[]               @relation("VisitorApprovedBy")
  maintenanceTickets   MaintenanceTicket[]      @relation("TicketRaisedBy")
  ticketAssignments    MaintenanceTicket[]      @relation("TicketAssignedTo")
  maintenanceComments  MaintenanceComment[]
  announcementsCreated Announcement[]
  announcementReads    AnnouncementReadStatus[]
  notificationLogs     NotificationLog[]
  consentLogs          ConsentLog[]
  auditLogs            AuditLog[]
  vehicles             Vehicle[]
  importJobsCreated    ImportJob[]              @relation("ImportCreatedBy")
  amenityReservations  AmenityReservation[]
  watchlistsCreated    SecurityWatchlist[]
  blacklistedVendors   Vendor[]                 @relation("VendorBlacklistedBy")
  contractRenewals     ContractRenewalHistory[] @relation("ContractRenewedBy")
  VendorFeedback       VendorFeedback[]
  documentsVerified    ResidentDocument[]       @relation("DocumentVerifiedBy")

  // Email must be unique per community (a user can exist in multiple communities
  // but as separate rows, since community contexts are isolated)
  @@unique([communityId, email])
  @@index([communityId])
  @@index([communityId, role])
  @@index([communityId, status])
  @@index([communityId, deletedAt])
  @@index([email])
  @@map("users")
}

/// Extended profile for residents (flat owners and tenants).
/// One-to-one with User; only users with role = RESIDENT | FAMILY_MEMBER.
model ResidentProfile {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String            @unique @db.Uuid
  communityId       String            @db.Uuid // Denormalized for efficient tenant filtering
  occupation        String?           @db.VarChar(200)
  dateOfBirth       DateTime?         @db.Date
  emergencyContact  Json? // { name, phone, relation }
  vehicleCount      Int               @default(0)
  isCommitteeMember Boolean           @default(false)
  verificationStage VerificationStage @default(PENDING)
  metadata          Json              @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents ResidentDocument[]

  @@index([communityId])
  @@index([communityId, verificationStage])
  @@map("resident_profiles")
}

/// Dedicated document storage for resident verification (KYC, address proof, etc.)
model ResidentDocument {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId        String         @db.Uuid
  residentProfileId  String         @db.Uuid
  documentType       String         @db.VarChar(100) // e.g., "GOVT_ID", "ADDRESS_PROOF", "OWNERSHIP_PROOF", "RENTAL_AGREEMENT"
  fileUrl            String         @db.Text
  verificationStatus DocumentStatus @default(PENDING)
  uploadedAt         DateTime       @default(now()) @db.Timestamptz
  verifiedAt         DateTime?      @db.Timestamptz
  verifiedById       String?        @db.Uuid
  metadata           Json           @default("{}")

  community       Community       @relation(fields: [communityId], references: [id], onDelete: Restrict)
  residentProfile ResidentProfile @relation(fields: [residentProfileId], references: [id], onDelete: Cascade)
  verifiedBy      User?           @relation("DocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([communityId])
  @@index([residentProfileId])
  @@index([communityId, verificationStatus])
  @@map("resident_documents")
}

/// Tracks OTPs issued for password recovery
model PasswordResetOtp {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String   @db.Uuid
  phone       String   @db.VarChar(20)
  otpHash     String   @db.Text
  expiresAt   DateTime @db.Timestamptz
  isUsed      Boolean  @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)

  @@index([communityId, phone])
  @@index([expiresAt])
  @@map("password_reset_otps")
}

/// Extended profile for community admins and managers.
/// One-to-one with User; only users with role = COMMUNITY_ADMIN | MANAGER | GUARD.
model AdminProfile {
  id                      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String  @unique @db.Uuid
  communityId             String  @db.Uuid // Denormalized
  designation             String? @db.VarChar(200) // "Secretary", "Treasurer", "President"
  permissions             Json    @default("[]") // Granular permission flags array
  canApproveGates         Boolean @default(false)
  canManageBilling        Boolean @default(false)
  canPublishAnnouncements Boolean @default(false)
  metadata                Json    @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@map("admin_profiles")
}

/// Extended profile for service staff (guards, plumbers, electricians, etc.)
/// One-to-one with User; only users with role = GUARD | STAFF.
model StaffProfile {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String        @unique @db.Uuid
  communityId   String        @db.Uuid // Denormalized
  employeeCode  String?       @db.VarChar(50)
  category      StaffCategory
  shift         String?       @db.VarChar(50) // "Morning", "Evening", "Night"
  shiftStart    DateTime?     @db.Time
  shiftEnd      DateTime?     @db.Time
  joiningDate   DateTime?     @db.Date
  identityProof Json? // { type: "AADHAAR"/"PAN", number, url }
  agencyName    String?       @db.VarChar(200) // If outsourced
  isOutsourced  Boolean       @default(false)
  rating        Decimal?      @db.Decimal(3, 2) // 0.00 - 5.00
  metadata      Json          @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)

  @@unique([communityId, employeeCode])
  @@index([communityId])
  @@index([communityId, category])
  @@map("staff_profiles")
}

// =============================================================================
// DOMAIN: UNIT OCCUPANCY (Resident ↔ Unit Assignment)
// =============================================================================

/// Junction table between users and units.
/// A resident can own/occupy multiple units (e.g. two flats).
/// A unit can have multiple residents (owner + tenants, or family).
/// Only ONE record per unit should have isPrimary = true at a time.
model ResidentUnitAssignment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId   String        @db.Uuid
  userId        String        @db.Uuid
  unitId        String        @db.Uuid
  occupancyType OccupancyType
  isPrimary     Boolean       @default(false) // Primary resident for billing/comms
  moveInDate    DateTime?     @db.Date
  moveOutDate   DateTime?     @db.Date
  leaseEndDate  DateTime?     @db.Date
  metadata      Json          @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit      Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)

  // A user is assigned to a specific unit only once at a time (active assignment)
  // Partial index handles this in migration.sql:
  // UNIQUE (user_id, unit_id) WHERE deleted_at IS NULL
  @@index([communityId])
  @@index([unitId])
  @@index([userId])
  @@index([communityId, deletedAt])
  @@map("resident_unit_assignments")
}

// =============================================================================
// DOMAIN: VEHICLES
// =============================================================================

/// Vehicle registry for residents and staff.
/// Used by gate guards to validate vehicles during entry/exit.
model Vehicle {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId   String      @db.Uuid
  userId        String      @db.Uuid // Owner (resident or staff)
  unitId        String?     @db.Uuid // Associated unit (null for staff vehicles)
  vehicleNumber String      @db.VarChar(20) // "MH-12-AB-1234"
  type          VehicleType
  make          String?     @db.VarChar(100) // "Maruti", "Honda"
  model         String?     @db.VarChar(100) // "Swift", "City"
  color         String?     @db.VarChar(50)
  rfidTag       String?     @db.VarChar(100) // RFID sticker number
  stickerNumber String?     @db.VarChar(50) // Physical sticker
  isVerified    Boolean     @default(false)
  metadata      Json        @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit      Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)

  // Vehicle number must be globally unique (a real vehicle plate is unique in reality)
  // Soft-delete aware: same plate can be re-registered after deletion
  @@unique([vehicleNumber, deletedAt])
  @@index([communityId])
  @@index([communityId, userId])
  @@index([vehicleNumber])
  @@map("vehicles")
}

// =============================================================================
// DOMAIN: GATE MANAGEMENT (Visitor Requests, Gate Passes, Entries)
// =============================================================================

/// Visitor pre-approval request created by a resident.
/// Generates a gate_pass upon creation.
/// Supports one-time, date-range, and recurring visitors.
model VisitorRequest {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId   String @db.Uuid
  requestedById String @db.Uuid // Resident who approved the visitor
  unitId        String @db.Uuid // Which unit the visitor is visiting

  visitorName      String               @db.VarChar(200)
  visitorPhone     String?              @db.VarChar(20)
  visitorPhoto     String?              @db.Text // URL
  vehicleNumber    String?              @db.VarChar(20)
  visitorType      VisitorType
  entryMode        VisitorEntryMode
  status           VisitorRequestStatus @default(PENDING)
  purpose          String?              @db.VarChar(500)
  validFrom        DateTime             @db.Timestamptz
  validUntil       DateTime?            @db.Timestamptz // null = single visit day
  responseDeadline DateTime?            @db.Timestamptz // Timeout for ON_ARRIVAL
  isRecurring      Boolean              @default(false)
  recurringDays    Json? // [0,1,2,3,4,5,6] (0=Sunday)
  allowedEntries   Int                  @default(1) // -1 = unlimited
  metadata         Json                 @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  community   Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  requestedBy User      @relation("VisitorRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  unit        Unit      @relation(fields: [unitId], references: [id], onDelete: Restrict)

  gatePass    GatePass?
  gateEntries GateEntry[]

  @@index([communityId])
  @@index([communityId, requestedById])
  @@index([communityId, unitId])
  @@index([communityId, validFrom, validUntil])
  @@index([communityId, status])
  @@index([communityId, deletedAt])
  @@map("visitor_requests")
}

/// Gate Pass: the actual credential used at the gate.
/// One GatePass per VisitorRequest (one-to-one).
/// Contains the QR token and pass code used by the guard / visitor app.
model GatePass {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId      String         @db.Uuid
  visitorRequestId String         @unique @db.Uuid
  qrToken          String         @unique @db.VarChar(500) // Long cryptographic token for QR code
  passCode         String         @db.VarChar(10) // Short human-readable code e.g. "GX4821"
  status           GatePassStatus @default(PENDING)
  approvedById     String?        @db.Uuid // Guard or admin who approved
  approvedAt       DateTime?      @db.Timestamptz
  deniedReason     String?        @db.VarChar(500)
  expiresAt        DateTime       @db.Timestamptz
  metadata         Json           @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  visitorRequest VisitorRequest @relation(fields: [visitorRequestId], references: [id], onDelete: Restrict)
  approvedBy     User?          @relation("VisitorApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  gateEntries    GateEntry[]

  // Pass code is unique per community (not globally) for active passes
  // Full constraint is a partial index in migration.sql:
  // UNIQUE (community_id, pass_code) WHERE status IN ('PENDING','APPROVED') AND deleted_at IS NULL
  @@index([communityId])
  @@index([communityId, status])
  @@index([qrToken])
  @@index([communityId, expiresAt])
  @@index([communityId, deletedAt])
  @@map("gate_passes")
}

/// Each physical entry/exit event recorded by the guard.
/// Multiple entries can be linked to one gate pass (for recurring visitors).
model GateEntry {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId      String    @db.Uuid
  visitorRequestId String?   @db.Uuid
  gatePassId       String?   @db.Uuid
  guardId          String?   @db.Uuid // Guard who logged the entry
  visitorName      String    @db.VarChar(200)
  vehicleNumber    String?   @db.VarChar(20)
  isVehicleEntry   Boolean   @default(false)
  inTime           DateTime  @db.Timestamptz
  outTime          DateTime? @db.Timestamptz
  photo            String?   @db.Text // Photo captured at gate
  notes            String?   @db.VarChar(500)
  metadata         Json      @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  visitorRequest VisitorRequest? @relation(fields: [visitorRequestId], references: [id], onDelete: SetNull)
  gatePass       GatePass?       @relation(fields: [gatePassId], references: [id], onDelete: SetNull)

  // NOTE: gate_entries intentionally has NO soft delete.
  // Entry logs are immutable audit records. Mistakes should be corrected via notes.
  @@index([communityId])
  @@index([communityId, gatePassId])
  @@index([communityId, inTime])
  @@index([communityId, visitorRequestId])
  @@map("gate_entries")
}

// =============================================================================
// DOMAIN: SECURITY (Watchlist)
// =============================================================================

model SecurityWatchlist {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String              @db.Uuid
  entityType  WatchlistEntityType
  entityValue String              @db.VarChar(200) // Phone number, vehicle number, or name
  level       WatchlistLevel      @default(WATCHLIST)
  reason      String?             @db.VarChar(500)
  addedById   String              @db.Uuid
  isActive    Boolean             @default(true)
  metadata    Json                @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  addedBy   User      @relation(fields: [addedById], references: [id], onDelete: Restrict)

  @@unique([communityId, entityType, entityValue])
  @@index([communityId, level])
  @@map("security_watchlists")
}

// =============================================================================
// DOMAIN: MAINTENANCE (Tickets / Complaints)
// =============================================================================

/// Category tree for maintenance requests (e.g., Plumbing > Water Leakage).
model MaintenanceCategory {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String  @db.Uuid
  parentId    String? @db.Uuid // Supports 2-level category hierarchy
  name        String  @db.VarChar(200)
  icon        String? @db.VarChar(100) // Icon name / URL
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  metadata    Json    @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  community Community             @relation(fields: [communityId], references: [id], onDelete: Restrict)
  parent    MaintenanceCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  MaintenanceCategory[] @relation("CategoryHierarchy")
  tickets   MaintenanceTicket[]

  @@unique([communityId, name, parentId])
  @@index([communityId])
  @@index([communityId, isActive])
  @@map("maintenance_categories")
}

/// A complaint or service request raised by a resident or admin.
model MaintenanceTicket {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId    String         @db.Uuid
  unitId         String?        @db.Uuid // May be null for common area issues
  categoryId     String         @db.Uuid
  raisedById     String         @db.Uuid // User who raised the ticket
  assignedToId   String?        @db.Uuid // Staff member assigned
  ticketNumber   String         @db.VarChar(30) // Human-readable e.g. "TKT-2024-001"
  title          String         @db.VarChar(500)
  description    String         @db.Text
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(OPEN)
  isCommonArea   Boolean        @default(false)
  scheduledAt    DateTime?      @db.Timestamptz // Planned resolution date
  resolvedAt     DateTime?      @db.Timestamptz
  closedAt       DateTime?      @db.Timestamptz
  resolutionNote String?        @db.Text
  rating         Int? // 1-5 stars (resident feedback on resolution)
  ratingNote     String?        @db.VarChar(500)
  metadata       Json           @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  community  Community           @relation(fields: [communityId], references: [id], onDelete: Restrict)
  unit       Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  category   MaintenanceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  raisedBy   User                @relation("TicketRaisedBy", fields: [raisedById], references: [id], onDelete: Restrict)
  assignedTo User?               @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  comments       MaintenanceComment[]
  attachments    MaintenanceAttachment[]
  workOrder      WorkOrder?
  VendorFeedback VendorFeedback[]

  @@unique([communityId, ticketNumber])
  @@index([communityId])
  @@index([communityId, status])
  @@index([communityId, priority])
  @@index([communityId, raisedById])
  @@index([communityId, assignedToId])
  @@index([communityId, categoryId])
  @@index([communityId, deletedAt])
  @@map("maintenance_tickets")
}

/// Thread of comments on a maintenance ticket.
model MaintenanceComment {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String  @db.Uuid
  ticketId    String  @db.Uuid
  authorId    String  @db.Uuid
  body        String  @db.Text
  isInternal  Boolean @default(false) // True = visible only to admins/staff
  metadata    Json    @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User              @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([communityId])
  @@index([ticketId])
  @@map("maintenance_comments")
}

/// File attachments on maintenance tickets (photos, videos, documents).
model MaintenanceAttachment {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId  String @db.Uuid
  ticketId     String @db.Uuid
  uploadedById String @db.Uuid
  fileUrl      String @db.Text
  fileName     String @db.VarChar(255)
  fileSize     Int // bytes
  mimeType     String @db.VarChar(100)
  metadata     Json   @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz

  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([ticketId])
  @@map("maintenance_attachments")
}

// =============================================================================
// DOMAIN: BILLING (Invoice Cycles, Invoices, Line Items, Payments)
// =============================================================================

/// A billing cycle defines the period and charge structure for invoices.
/// Community admins create cycles; invoices are generated per unit per cycle.
model InvoiceCycle {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId  String                @db.Uuid
  name         String                @db.VarChar(200) // "April 2024 Maintenance"
  frequency    InvoiceCycleFrequency
  startDate    DateTime              @db.Date
  endDate      DateTime              @db.Date
  dueDate      DateTime              @db.Date
  baseAmount   Decimal               @db.Decimal(12, 2)
  lateFeeType  String?               @db.VarChar(20) // "FLAT" | "PERCENTAGE"
  lateFeeValue Decimal?              @db.Decimal(10, 2)
  isPublished  Boolean               @default(false)
  metadata     Json                  @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  invoices  Invoice[]

  @@index([communityId])
  @@index([communityId, isPublished])
  @@index([communityId, startDate, endDate])
  @@map("invoice_cycles")
}

/// An invoice generated for a specific unit for a billing cycle.
model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId    String        @db.Uuid
  cycleId        String        @db.Uuid
  unitId         String        @db.Uuid
  invoiceNumber  String        @db.VarChar(50) // "INV-2024-04-0001"
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  lateFee        Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  invoiceDate    DateTime      @default(now()) @db.Date
  dueDate        DateTime      @db.Date
  notes          String?       @db.Text
  metadata       Json          @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  community Community    @relation(fields: [communityId], references: [id], onDelete: Restrict)
  cycle     InvoiceCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  unit      Unit         @relation(fields: [unitId], references: [id], onDelete: Restrict)

  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@unique([communityId, invoiceNumber])
  @@unique([cycleId, unitId]) // One invoice per unit per cycle
  @@index([communityId])
  @@index([communityId, status])
  @@index([communityId, unitId])
  @@index([communityId, dueDate])
  @@index([communityId, deletedAt])
  @@map("invoices")
}

/// Individual line items within an invoice (maintenance, water, gym, parking, etc.)
model InvoiceLineItem {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String  @db.Uuid
  invoiceId   String  @db.Uuid
  description String  @db.VarChar(500)
  quantity    Decimal @default(1) @db.Decimal(10, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2) // percentage e.g. 18.00
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)
  metadata    Json    @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// A payment transaction against an invoice.
/// Supports partial payments (multiple payments per invoice).
model Payment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId     String        @db.Uuid
  invoiceId       String        @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  mode            PaymentMode
  status          PaymentStatus @default(PENDING)
  gatewayTxnId    String?       @db.VarChar(200) // Payment gateway transaction ID
  gatewayProvider String?       @db.VarChar(100) // "RAZORPAY", "STRIPE", etc.
  gatewayResponse Json? // Raw gateway webhook payload
  paidAt          DateTime?     @db.Timestamptz
  receiptNumber   String?       @db.VarChar(100)
  notes           String?       @db.VarChar(500)
  metadata        Json          @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  // Payment records are immutable: no soft delete.
  // Refunds are a separate entry with negative amount or status=REFUNDED.
  @@index([communityId])
  @@index([invoiceId])
  @@index([communityId, status])
  @@index([gatewayTxnId])
  @@map("payments")
}

// =============================================================================
// DOMAIN: COMMUNICATION (Announcements, Notifications, Consent Logs)
// =============================================================================

/// Announcements / notices published by admins to residents.
model Announcement {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId     String               @db.Uuid
  authorId        String               @db.Uuid
  title           String               @db.VarChar(500)
  description     String?              @db.Text
  content         String               @db.Text
  priority        AnnouncementPriority @default(NORMAL)
  status          AnnouncementStatus   @default(DRAFT)
  targetAudiences TargetAudience[]
  isPinned        Boolean              @default(false)
  publishedAt     DateTime?            @db.Timestamptz // null = draft
  expiresAt       DateTime?            @db.Timestamptz
  attachments     Json                 @default("[]") // [{url, name, type}]
  metadata        Json                 @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)

  reads AnnouncementReadStatus[]

  @@index([communityId])
  @@index([communityId, status])
  @@index([communityId, publishedAt])
  @@index([communityId, isPinned])
  @@index([communityId, deletedAt])
  @@map("announcements")
}

/// Read receipts: tracks which user has read which announcement.
/// Used for "seen by X residents" stats and unread badges.
model AnnouncementReadStatus {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId    String   @db.Uuid
  announcementId String   @db.Uuid
  userId         String   @db.Uuid
  readAt         DateTime @default(now()) @db.Timestamptz

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([communityId])
  @@index([announcementId])
  @@index([userId])
  @@map("announcement_read_statuses")
}

/// Log of all push/SMS/email/WhatsApp notifications sent to users.
/// Used for delivery status tracking and retry logic.
model NotificationLog {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId   String              @db.Uuid
  userId        String              @db.Uuid
  channel       NotificationChannel
  title         String              @db.VarChar(500)
  body          String              @db.Text
  referenceId   String?             @db.Uuid // Link to source entity (announcement, invoice, etc.)
  referenceType String?             @db.VarChar(100) // "announcement", "invoice", "gate_pass"
  isRead        Boolean             @default(false)
  readAt        DateTime?           @db.Timestamptz
  deliveredAt   DateTime?           @db.Timestamptz
  failureReason String?             @db.VarChar(500)
  metadata      Json                @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([userId, isRead])
  @@index([communityId, createdAt])
  @@index([referenceId])
  @@map("notification_logs")
}

/// Consent log: records explicit user consent for data processing (PDPB/GDPR compliance).
model ConsentLog {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String  @db.Uuid
  userId      String  @db.Uuid
  consentType String  @db.VarChar(100) // "TERMS_OF_SERVICE", "PRIVACY_POLICY", "MARKETING"
  version     String  @db.VarChar(50) // Document version accepted
  accepted    Boolean
  ipAddress   String? @db.VarChar(45) // IPv4 or IPv6
  userAgent   String? @db.Text
  metadata    Json    @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([userId])
  @@index([userId, consentType])
  @@map("consent_logs")
}

// =============================================================================
// DOMAIN: AUDIT LOGGING
// =============================================================================

/// Immutable audit trail of all significant data changes in the system.
/// Written directly from the application layer (not DB triggers, for flexibility).
/// Records WHO changed WHAT, WHEN, and a before/after diff.
model AuditLog {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String?     @db.Uuid // Nullable: SUPER_ADMIN actions may be cross-community
  actorId     String?     @db.Uuid // Null = system-initiated action
  action      AuditAction
  tableName   String      @db.VarChar(100)
  recordId    String      @db.VarChar(100) // The PK of the affected record (stored as text for flexibility)
  oldValues   Json? // Snapshot before change
  newValues   Json? // Snapshot after change
  ipAddress   String?     @db.VarChar(45)
  userAgent   String?     @db.Text
  metadata    Json        @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz

  actor     User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  community Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)

  // Audit logs are NEVER soft-deleted or mutated.
  @@index([communityId])
  @@index([actorId])
  @@index([tableName, recordId])
  @@index([communityId, action])
  @@index([communityId, createdAt])
  @@map("audit_logs")
}

// =============================================================================
// DOMAIN: SYSTEM (Imports & Jobs)
// =============================================================================

/// Tracks bulk import jobs
model ImportJob {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId      String       @db.Uuid
  type             ImportType
  status           ImportStatus @default(PENDING)
  originalFileName String       @db.VarChar(500)
  totalRows        Int          @default(0)
  successRows      Int          @default(0)
  failedRows       Int          @default(0)
  errorFilePath    String?      @db.Text
  resultFilePath   String?      @db.Text

  startedAt   DateTime? @db.Timestamptz
  completedAt DateTime? @db.Timestamptz

  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  createdBy User      @relation("ImportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([communityId])
  @@index([communityId, status])
  @@index([communityId, type])
  @@map("import_jobs")
}

// =============================================================================
// DOMAIN: AMENITIES
// =============================================================================

/// Community amenities (Clubhouse, Gym, Pool, etc.)
model Amenity {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId    String  @db.Uuid
  name           String  @db.VarChar(200)
  description    String? @db.Text
  capacity       Int     @default(1)
  bookingEnabled Boolean @default(true)
  autoApprove    Boolean @default(true)
  metadata       Json    @default("{}")

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  community    Community            @relation(fields: [communityId], references: [id], onDelete: Restrict)
  reservations AmenityReservation[]

  @@unique([communityId, name])
  @@index([communityId])
  @@index([communityId, deletedAt])
  @@map("amenities")
}

/// Reservations for amenities
model AmenityReservation {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String            @db.Uuid
  amenityId   String            @db.Uuid
  residentId  String            @db.Uuid
  bookingDate DateTime          @db.Date
  startTime   DateTime          @db.Time
  endTime     DateTime          @db.Time
  status      ReservationStatus @default(PENDING)
  notes       String?           @db.VarChar(500)
  metadata    Json              @default("{}")

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Restrict)
  amenity   Amenity   @relation(fields: [amenityId], references: [id], onDelete: Restrict)
  resident  User      @relation(fields: [residentId], references: [id], onDelete: Restrict)

  @@index([communityId])
  @@index([amenityId])
  @@index([residentId])
  @@index([communityId, bookingDate])
  @@index([communityId, status])
  @@map("amenity_reservations")
}

// =============================================================================
// DOMAIN: VENDOR & CONTRACT MANAGEMENT
// =============================================================================

model Vendor {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId   String         @map("community_id") @db.Uuid
  name          String         @db.VarChar(255)
  category      VendorCategory
  contactPerson String         @map("contact_person") @db.VarChar(100)
  phone         String         @db.VarChar(20)
  email         String         @db.VarChar(100)
  status        VendorStatus   @default(ACTIVE)
  riskLevel     RiskLevel      @default(LOW) @map("risk_level")

  blacklistReason  String?   @map("blacklist_reason") @db.Text
  blacklistDate    DateTime? @map("blacklist_date")
  blacklistAdminId String?   @map("blacklist_admin_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  admin     User?     @relation("VendorBlacklistedBy", fields: [blacklistAdminId], references: [id], onDelete: SetNull)

  contracts          Contract[]
  workOrders         WorkOrder[]
  complianceRecords  ComplianceRecord[]
  payments           VendorPayment[]
  feedbacks          VendorFeedback[]
  performanceMetrics VendorPerformanceMetric[]

  @@index([communityId])
  @@index([communityId, category])
  @@index([communityId, status])
  @@map("vendors")
}

model Contract {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId    String         @map("community_id") @db.Uuid
  vendorId       String         @map("vendor_id") @db.Uuid
  contractNumber String         @map("contract_number") @db.VarChar(100)
  value          Decimal        @db.Decimal(10, 2)
  startDate      DateTime       @map("start_date")
  endDate        DateTime       @map("end_date")
  renewalDate    DateTime?      @map("renewal_date")
  noticePeriod   Int            @map("notice_period") // in days
  paymentTerms   String         @map("payment_terms") @db.VarChar(255)
  sla            String         @db.Text
  status         ContractStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  community Community                @relation(fields: [communityId], references: [id], onDelete: Cascade)
  vendor    Vendor                   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  renewals  ContractRenewalHistory[]
  payments  VendorPayment[]

  @@index([communityId])
  @@index([vendorId])
  @@index([communityId, status])
  @@map("vendor_contracts")
}

model ContractRenewalHistory {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String                @map("community_id") @db.Uuid
  contractId  String                @map("contract_id") @db.Uuid
  status      ContractRenewalStatus
  notes       String?               @db.Text
  adminId     String                @map("admin_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  contract  Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  admin     User      @relation("ContractRenewedBy", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([communityId])
  @@index([contractId])
  @@map("contract_renewals")
}

model WorkOrder {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId    String          @map("community_id") @db.Uuid
  vendorId       String          @map("vendor_id") @db.Uuid
  ticketId       String?         @unique @map("ticket_id") @db.Uuid
  orderNumber    String          @map("order_number") @db.VarChar(100)
  priority       TicketPriority  @default(MEDIUM)
  assignedDate   DateTime        @map("assigned_date")
  dueDate        DateTime        @map("due_date")
  completionDate DateTime?       @map("completion_date")
  status         WorkOrderStatus @default(CREATED)
  cost           Decimal?        @db.Decimal(10, 2)
  adminNotes     String?         @map("admin_notes") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  community Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  vendor    Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  ticket    MaintenanceTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([communityId])
  @@index([vendorId])
  @@index([communityId, status])
  @@map("work_orders")
}

model ComplianceRecord {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId  String           @map("community_id") @db.Uuid
  vendorId     String           @map("vendor_id") @db.Uuid
  documentType String           @map("document_type") @db.VarChar(100)
  status       ComplianceStatus @default(VALID)
  expiryDate   DateTime?        @map("expiry_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([vendorId])
  @@index([communityId, status])
  @@map("vendor_compliance")
}

model VendorPayment {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId   String        @map("community_id") @db.Uuid
  vendorId      String        @map("vendor_id") @db.Uuid
  contractId    String?       @map("contract_id") @db.Uuid
  amount        Decimal       @db.Decimal(10, 2)
  paymentDate   DateTime      @map("payment_date")
  invoiceNumber String        @map("invoice_number") @db.VarChar(100)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  remarks       String?       @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  contract  Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([communityId])
  @@index([vendorId])
  @@index([communityId, paymentStatus])
  @@map("vendor_payments")
}

model VendorFeedback {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String  @map("community_id") @db.Uuid
  vendorId    String  @map("vendor_id") @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  ticketId    String? @map("ticket_id") @db.Uuid
  rating      Decimal @db.Decimal(3, 2)
  comments    String? @db.Text
  source      String  @db.VarChar(50) // e.g. "RESIDENT", "ADMIN"

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  community Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  vendor    Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket    MaintenanceTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([communityId])
  @@index([vendorId])
  @@index([userId])
  @@map("vendor_feedbacks")
}

model VendorPerformanceMetric {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String   @map("community_id") @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  metricType  String   @map("metric_type") @db.VarChar(100) // e.g. "SLA_BREACH", "COMPLETION_TIME", "SECURITY_INCIDENT"
  metricValue Decimal  @db.Decimal(10, 2)
  recordedAt  DateTime @default(now()) @map("recorded_at")
  referenceId String?  @map("reference_id") @db.Uuid // Optional link to WorkOrder or Security Incident
  notes       String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([vendorId])
  @@index([metricType])
  @@map("vendor_performance_metrics")
}

// =============================================================================
// DOMAIN: SECURITY GUARDS OPERATIONS
// =============================================================================

model GateAssignment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String   @map("community_id") @db.Uuid
  name        String   @db.VarChar(100) // "Main Gate", "Service Gate", "Tower Gate", "Clubhouse Gate"
  code        String   @db.VarChar(50) // e.g., "MAIN", "SERVICE", "TOWER", "CLUBHOUSE"
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  community Community    @relation(fields: [communityId], references: [id], onDelete: Cascade)
  shifts    GuardShift[]

  @@unique([communityId, name])
  @@unique([communityId, code])
  @@index([communityId])
  @@map("gate_assignments")
}

model GuardShift {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId  String   @map("community_id") @db.Uuid
  guardId      String   @map("guard_id") @db.Uuid
  shiftType    String   @map("shift_type") @db.VarChar(50) // MORNING, EVENING, NIGHT, CUSTOM
  startTime    String   @map("start_time") @db.VarChar(10) // e.g., "06:00"
  endTime      String   @map("end_time") @db.VarChar(10) // e.g., "14:00"
  gateId       String   @map("gate_id") @db.Uuid
  supervisorId String?  @map("supervisor_id") @db.Uuid
  status       String   @default("ON_DUTY") // ON_DUTY, BREAK, OFF_DUTY
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  community  Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  guard      User           @relation("GuardShifts", fields: [guardId], references: [id], onDelete: Cascade)
  supervisor User?          @relation("SupervisorShifts", fields: [supervisorId], references: [id], onDelete: SetNull)
  gate       GateAssignment @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([guardId])
  @@map("guard_shifts")
}

model GuardAttendance {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId String    @map("community_id") @db.Uuid
  guardId     String    @map("guard_id") @db.Uuid
  date        DateTime  @db.Date
  checkIn     DateTime? @map("check_in") @db.Timestamptz
  checkOut    DateTime? @map("check_out") @db.Timestamptz
  totalHours  Decimal?  @map("total_hours") @db.Decimal(5, 2)
  isLate      Boolean   @default(false) @map("is_late")
  status      String    @default("PRESENT") // PRESENT, ABSENT, LATE
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  guard     User      @relation(fields: [guardId], references: [id], onDelete: Cascade)

  @@unique([communityId, guardId, date])
  @@index([communityId])
  @@index([guardId])
  @@map("guard_attendance")
}

model GuardIncident {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  communityId    String   @map("community_id") @db.Uuid
  guardId        String   @map("guard_id") @db.Uuid
  incidentType   String   @map("incident_type") @db.VarChar(100) // UNAUTHORIZED_ENTRY, VENDOR_VIOLATION, RESIDENT_COMPLAINT, EMERGENCY, SECURITY_BREACH
  severity       String   @db.VarChar(20) // LOW, MEDIUM, HIGH, CRITICAL
  status         String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  incidentDate   DateTime @map("incident_date") @db.Timestamptz
  description    String   @db.Text
  resolutionNote String?  @map("resolution_note") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  guard     User      @relation(fields: [guardId], references: [id], onDelete: Cascade)

  @@index([communityId])
  @@index([guardId])
  @@map("guard_incidents")
}
