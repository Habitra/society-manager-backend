# ============================================================
# Society Manager Backend — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----- App -----
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# ----- Supabase (DEPRECATED) -----
# Supabase auth is no longer used (replaced by local JWT auth).
# These keys are now optional and can be left empty.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ----- Database -----
# Use the pooled (PgBouncer) URL for the app, direct URL for migrations
DATABASE_URL="postgresql://postgres.your-project-ref:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://postgres.your-project-ref:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ----- JWT Secrets (REQUIRED) -----
# Both secrets MUST be at least 32 characters. The app will refuse to start without them.
# Generate secure values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# NEVER use default or placeholder values in any environment.
# Use a DIFFERENT value for each secret and for each environment (dev/staging/prod).
JWT_SECRET=replace-with-at-least-64-hex-chars-generated-by-crypto-randomBytes
JWT_REFRESH_SECRET=replace-with-a-different-at-least-64-hex-chars-value

# ----- JWT Token Expiry -----
# Access tokens are short-lived (15m). The frontend must use the refresh endpoint.
# Refresh tokens are valid for 7 days. Logging out clears the refresh token from DB.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ----- Security -----
# Rate limiting: max requests per TTL window per IP
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ----- CORS -----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# ----- Swagger -----
# Set to 'true' ONLY in development. Default is 'false' (disabled).
# NEVER set to 'true' in production.
SWAGGER_ENABLED=true

# ----- External: Firebase FCM -----
# For push notifications (Expo + Firebase)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# ----- External: Razorpay -----
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ----- External: MSG91 (SMS OTP) -----
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=SCTMGR
MSG91_TEMPLATE_ID=your-otp-template-id

# ----- External: Resend (Email) -----
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.in
